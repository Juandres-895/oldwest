# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase
# (Project Settings > API en el dashboard de supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para generar los QR y metadata).
# En local: http://localhost:3000
# En producción: la URL de Vercel, luego tu dominio propio cuando lo tengas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
